# Copy to .env and adjust as needed.

# MongoDB connection string. For local dev: `brew services start mongodb-community@6.0`
# (or `mongod --dbpath /path/to/data`), then this default just works. For
# MongoDB Atlas, use the connection string from the Atlas UI (must include a
# database name).
DATABASE_URL="mongodb://127.0.0.1:27017/cuemaster"

# HTTP server port (REST + Socket.IO share this port).
PORT=4000

# Comma-separated list of allowed CORS origins. Use "*" to allow any origin
# (fine for local dev with an Expo app; tighten this in production).
CORS_ORIGIN=*

# Secret used to sign JWTs. Generate a real one for anything beyond local dev,
# e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me

# How long a session/JWT stays valid.
SESSION_LENGTH_DAYS=30

# bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=12
