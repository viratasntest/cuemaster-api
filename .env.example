# Copy to .env and adjust as needed.

# MongoDB connection string. For local dev: `brew services start mongodb-community@6.0`
# (or `mongod --dbpath /path/to/data`), then this default just works. For
# MongoDB Atlas, use the connection string from the Atlas UI (must include a
# database name).
DATABASE_URL="mongodb://127.0.0.1:27017/cuemaster"

# HTTP server port (REST + Socket.IO share this port).
PORT=4000

# Comma-separated list of allowed CORS origins. Use "*" to allow any origin
# (fine for local dev with an Expo app; tighten this in production).
CORS_ORIGIN=*

# Secret used to sign JWTs. Generate a real one for anything beyond local dev,
# e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me

# How long a session/JWT stays valid.
SESSION_LENGTH_DAYS=30

# bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=12

# --- Social Login (docs/BACKEND.md) ---
# Comma-separated OAuth client id(s) from Google Cloud Console — the server
# rejects a Google sign-in whose id_token `aud` claim isn't one of these.
# Leave unset to disable POST /auth/social/google with a clear error.
GOOGLE_CLIENT_IDS=
# From Facebook Developer Console (Settings > Basic). Both required to
# enable POST /auth/social/facebook; used to verify the client's token
# actually belongs to this app via the Graph API's debug_token endpoint.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Avatar Upload (docs/BACKEND.md) ---
# Public URL clients can reach this server at — avatarUrl values are built
# as `${PUBLIC_BASE_URL}/uploads/<file>`. Must be a real reachable host for
# anything beyond the simulator/local network (e.g. an ngrok URL, or your
# deployed domain) — a phone can't resolve "localhost" to your laptop.
PUBLIC_BASE_URL=http://localhost:4000
# Where uploaded avatar files are written on disk, relative to the repo root.
UPLOAD_DIR=uploads
# Max avatar upload size in bytes.
AVATAR_MAX_BYTES=5242880
